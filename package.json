{
  "name": "chronoarchive",
  "displayName": "ChronoArchive",
  "description": "%extension.description%",
  "version": "1.1.10",
  "publisher": "lenik",
  "repository": {
    "type": "git",
    "url": "https://github.com/lenik/chronoarchive.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:chronoarchive",
    "onCommand:chronoarchive.openDailyLog",
    "onCommand:chronoarchive.openDailyLogPreviousDay",
    "onCommand:chronoarchive.openDailyLogNextDay",
    "onCommand:chronoarchive.openDailyLogPreviousDayCreate",
    "onCommand:chronoarchive.openDailyLogNextDayCreate"
  ],
  "main": "./dist/extension.js",
  "icon": "icons/icon.png",
  "contributes": {
    "configurationDefaults": {
      "[chronoarchive]": {
        "editor.trimAutoWhitespace": false,
        "editor.autoIndent": "full",
        "editor.semanticHighlighting.enabled": true
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "date.italic": {
            "fontStyle": "italic"
          },
          "modifier.bold": {
            "fontStyle": "bold"
          },
          "lineBeforeHead.underline": {
            "fontStyle": "underline"
          }
        }
      }
    },
    "languages": [
      {
        "id": "chronoarchive",
        "aliases": [
          "ChronoArchive",
          "chronoarchive"
        ],
        "extensions": [
          ".car"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/icon-light.svg",
          "dark": "./icons/icon-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "chronoarchive",
        "scopeName": "source.chronoarchive",
        "path": "./syntaxes/chronoarchive.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "flag",
        "description": "%semantic.flag%"
      },
      {
        "id": "date",
        "description": "%semantic.date%"
      },
      {
        "id": "time",
        "description": "%semantic.time%"
      },
      {
        "id": "modifier",
        "description": "%semantic.modifier%"
      },
      {
        "id": "attributeName",
        "description": "%semantic.attributeName%"
      },
      {
        "id": "attributeValue",
        "description": "%semantic.attributeValue%"
      },
      {
        "id": "lineBeforeHead",
        "description": "%semantic.lineBeforeHead%"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "italic",
        "description": "%semantic.modifier.italic%"
      },
      {
        "id": "bold",
        "description": "%semantic.modifier.bold%"
      },
      {
        "id": "underline",
        "description": "%semantic.modifier.underline%"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "chronoarchive",
        "scopes": {
          "flag": [
            "keyword.control.chronoarchive"
          ],
          "date": [
            "constant.numeric.date.chronoarchive"
          ],
          "date.italic": [
            "constant.numeric.date.chronoarchive"
          ],
          "time": [
            "constant.numeric.time.chronoarchive"
          ],
          "modifier": [
            "entity.other.attribute-name.chronoarchive"
          ],
          "modifier.bold": [
            "entity.other.attribute-name.chronoarchive"
          ],
          "lineBeforeHead": [
            "markup.underline.chronoarchive"
          ],
          "lineBeforeHead.underline": [
            "markup.underline.chronoarchive"
          ],
          "attributeName": [
            "variable.other.chronoarchive"
          ],
          "attributeValue": [
            "string.unquoted.chronoarchive"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "chronoarchive.toggleDone",
        "title": "%command.toggleDone%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.toggleIgnored",
        "title": "%command.toggleIgnored%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.toggleExclamation",
        "title": "%command.toggleExclamation%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.setPriority1",
        "title": "%command.setPriority1%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.setPriority2",
        "title": "%command.setPriority2%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.setPriority3",
        "title": "%command.setPriority3%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.setPriority4",
        "title": "%command.setPriority4%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.setPriority5",
        "title": "%command.setPriority5%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.moveItemUp",
        "title": "%command.moveItemUp%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.moveItemDown",
        "title": "%command.moveItemDown%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.moveLineUp",
        "title": "%command.moveLineUp%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.moveLineDown",
        "title": "%command.moveLineDown%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.addItemAfter",
        "title": "%command.addItemAfter%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.addItemBefore",
        "title": "%command.addItemBefore%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.addItemBeforeCurrentLine",
        "title": "%command.addItemBeforeCurrentLine%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.addItemAtEnd",
        "title": "%command.addItemAtEnd%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.deleteItem",
        "title": "%command.deleteItem%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.jumpToNextItem",
        "title": "%command.jumpToNextItem%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.jumpToPreviousItem",
        "title": "%command.jumpToPreviousItem%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.toggleDoneCycle",
        "title": "%command.toggleDoneCycle%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.toggleClosedCycle",
        "title": "%command.toggleClosedCycle%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.togglePendingCycle",
        "title": "%command.togglePendingCycle%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.toggleImportanceCycle",
        "title": "%command.toggleImportanceCycle%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.toggleAttentionCycle",
        "title": "%command.toggleAttentionCycle%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.toggleDrinkCycle",
        "title": "%command.toggleDrinkCycle%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.toggleGoodEmotionCycle",
        "title": "%command.toggleGoodEmotionCycle%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.toggleBadEmotionCycle",
        "title": "%command.toggleBadEmotionCycle%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.openDailyLog",
        "title": "%command.openDailyLog%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.openDailyLogPreviousDay",
        "title": "%command.openDailyLogPreviousDay%",
        "category": "%category.chronoarchive%"
      },
      {
        "command": "chronoarchive.openDailyLogNextDay",
        "title": "%command.openDailyLogNextDay%",
        "category": "%category.chronoarchive%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "chronoarchive.blankLinesBetweenItems": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 3,
          "description": "%config.blankLinesBetweenItems%"
        },
        "chronoarchive.dailyLogsRoot": {
          "type": "string",
          "default": "",
          "description": "%config.dailyLogsRoot%"
        },
        "chronoarchive.dailyLogTemplatePath": {
          "type": "string",
          "default": "",
          "description": "%config.dailyLogTemplatePath%"
        }
      }
    },
    "keybindings": [
      {
        "command": "chronoarchive.toggleDoneCycle",
        "key": "ctrl+/",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.toggleDrinkCycle",
        "key": "ctrl+shift+2",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.toggleGoodEmotionCycle",
        "key": "ctrl+shift+0",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.toggleBadEmotionCycle",
        "key": "ctrl+shift+9",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.toggleClosedCycle",
        "key": "ctrl+'",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.togglePendingCycle",
        "key": "ctrl+shift+/",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.toggleImportanceCycle",
        "key": "ctrl+shift+\\",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.toggleAttentionCycle",
        "key": "ctrl+shift+'",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "-editor.action.quickFix",
        "key": "ctrl+1",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.setPriority1",
        "key": "ctrl+1",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.setPriority2",
        "key": "ctrl+2",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.setPriority3",
        "key": "ctrl+3",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.setPriority4",
        "key": "ctrl+4",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.setPriority5",
        "key": "ctrl+5",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.moveItemUp",
        "key": "alt+k",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.moveItemDown",
        "key": "alt+j",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.moveLineUp",
        "key": "alt+up",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.moveLineDown",
        "key": "alt+down",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.addItemAfter",
        "key": "alt+]",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.addItemBefore",
        "key": "alt+[",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.addItemBeforeCurrentLine",
        "key": "alt+shift+[",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.addItemAtEnd",
        "key": "ctrl+alt+=",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.deleteItem",
        "key": "alt+delete",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.jumpToNextItem",
        "key": "ctrl+j",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.jumpToPreviousItem",
        "key": "ctrl+k",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.openDailyLog",
        "key": "ctrl+alt+d"
      },
      {
        "command": "chronoarchive.openDailyLog",
        "key": "alt+meta+d"
      },
      {
        "command": "chronoarchive.openDailyLogPreviousDay",
        "key": "alt+pageup",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.openDailyLogNextDay",
        "key": "alt+pagedown",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.openDailyLogPreviousDayCreate",
        "key": "ctrl+alt+pageup",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      },
      {
        "command": "chronoarchive.openDailyLogNextDayCreate",
        "key": "ctrl+alt+pagedown",
        "when": "editorTextFocus && editorLangId == chronoarchive"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run bundle",
    "compile": "tsc -p ./",
    "bundle": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package --no-dependencies",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "ovsx": "^0.10.10",
    "typescript": "^4.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
